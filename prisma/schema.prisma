generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  DISABLED
}

enum RoleKey {
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

enum RecurringTemplateStatus {
  ACTIVE
  PAUSED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
}

enum RecurringGenerationOutcome {
  CREATED
  SKIPPED
  FAILED
}

enum RecurringInvoiceStatus {
  DRAFT
  SENT
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
  STRIPE_CHECKOUT
}

enum PaymentSource {
  MANUAL
  STRIPE
}

enum ActivityLogType {
  BUSINESS_CREATED
  USER_CREATED
  CLIENT_CREATED
  CLIENT_ARCHIVED
  INVOICE_CREATED
  INVOICE_STATUS_CHANGED
  RECURRING_TEMPLATE_CREATED
  RECURRING_INVOICE_GENERATED
  PAYMENT_RECORDED
  STRIPE_PAYMENT_COMPLETED
  STRIPE_PAYMENT_FAILED
}

model Business {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String                     @unique
  status                   BusinessStatus             @default(ACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  settings                 BusinessSettings?
  roles                    Role[]
  users                    User[]                     @relation("BusinessUsers")
  activeUsers              User[]                     @relation("UserActiveBusiness")
  clients                  Client[]
  invoices                 Invoice[]
  payments                 Payment[]
  activityLogs             ActivityLog[]
  recurringTemplates       RecurringInvoiceTemplate[]
  recurringGenerationRuns  RecurringInvoiceGeneration[]
}

model BusinessSettings {
  id           String   @id @default(cuid())
  businessId   String   @unique
  currencyCode String   @default("USD") @db.VarChar(3)
  timezone     String   @default("America/New_York")
  locale       String   @default("en-US")
  nextInvoiceNumber Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(cuid())
  businessId  String
  key         RoleKey
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([businessId, key])
  @@unique([businessId, id])
  @@index([businessId])
}

model User {
  id               String     @id @default(cuid())
  businessId       String
  activeBusinessId String?
  roleId           String
  status           UserStatus @default(ACTIVE)
  fullName         String
  email            String     @unique
  username         String     @unique
  phone            String?   @unique
  passwordHash     String
  image            String?
  emailVerified    DateTime?
  lastSignedInAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  business         Business   @relation("BusinessUsers", fields: [businessId], references: [id], onDelete: Cascade)
  activeBusiness   Business?  @relation("UserActiveBusiness", fields: [activeBusinessId], references: [id], onDelete: SetNull)
  role             Role       @relation(fields: [businessId, roleId], references: [businessId, id], onDelete: Restrict)
  accounts         Account[]
  sessions         Session[]
  clientProfile    Client?

  @@index([businessId])
  @@index([activeBusinessId])
  @@index([roleId])
  @@index([businessId, roleId])
  @@unique([businessId, id])
}

model Client {
  id                 String                     @id @default(cuid())
  businessId         String
  userId             String?
  status             ClientStatus               @default(ACTIVE)
  fullName           String
  companyName        String?
  email              String
  phone              String
  username           String?
  notes              String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  business           Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user               User?                      @relation(fields: [businessId, userId], references: [businessId, id], onDelete: Restrict)
  invoices           Invoice[]
  recurringTemplates RecurringInvoiceTemplate[]

  @@index([businessId])
  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@unique([businessId, username])
  @@unique([businessId, userId])
  @@unique([businessId, id])
}

model Invoice {
  id                      String                      @id @default(cuid())
  businessId              String
  clientId                String
  recurringTemplateId     String?
  recurringWindowStart    DateTime?
  invoiceNumber           String
  status                  InvoiceStatus               @default(DRAFT)
  issuedAt                DateTime
  dueAt                   DateTime
  subtotal                Int
  tax                     Int                         @default(0)
  total                   Int
  paidAmount              Int                         @default(0)
  taxRateBps              Int                         @default(0)
  notes                   String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  business                Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client                  Client                      @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  recurringTemplate       RecurringInvoiceTemplate?   @relation("GeneratedInvoices", fields: [businessId, recurringTemplateId], references: [businessId, id], onDelete: Restrict)
  recurringGenerationRuns RecurringInvoiceGeneration[] @relation("RecurringGenerationInvoice")
  lineItems               InvoiceLineItem[]
  payments                Payment[]

  @@unique([businessId, invoiceNumber])
  @@unique([recurringTemplateId, recurringWindowStart])
  @@index([businessId, clientId])
  @@index([businessId, status, dueAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}

model RecurringInvoiceTemplate {
  id                    String                     @id @default(cuid())
  businessId            String
  clientId              String
  name                  String
  status                RecurringTemplateStatus    @default(ACTIVE)
  frequency             RecurringFrequency
  intervalCount         Int                        @default(1)
  dayOfWeek             Int?
  dayOfMonth            Int?
  startsAt              DateTime
  endsAt                DateTime?
  nextRunAt             DateTime
  dueInDays             Int                        @default(0)
  invoiceStatus         RecurringInvoiceStatus     @default(DRAFT)
  taxRateBps            Int                        @default(0)
  notes                 String?
  lastRunAt             DateTime?
  lastGeneratedAt       DateTime?
  lastGeneratedInvoiceId String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client                Client                     @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lineItems             RecurringInvoiceTemplateLineItem[]
  generatedInvoices     Invoice[]                  @relation("GeneratedInvoices")
  generationResults     RecurringInvoiceGeneration[]

  @@index([businessId, status, nextRunAt])
  @@index([businessId, clientId])
  @@unique([businessId, id])
}

model RecurringInvoiceTemplateLineItem {
  id          String                   @id @default(cuid())
  templateId  String
  description String
  quantity    Int
  unitPrice   Int
  sortOrder   Int
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  template    RecurringInvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model RecurringInvoiceGeneration {
  id           String                    @id @default(cuid())
  businessId   String
  templateId   String
  invoiceId    String?
  outcome      RecurringGenerationOutcome
  scheduledFor DateTime
  runAt        DateTime
  message      String
  createdAt    DateTime                  @default(now())
  business     Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template     RecurringInvoiceTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  invoice      Invoice?                  @relation("RecurringGenerationInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([templateId, scheduledFor])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                     String        @id @default(cuid())
  businessId             String
  invoiceId              String
  amount                 Int
  method                 PaymentMethod
  source                 PaymentSource @default(MANUAL)
  stripePaymentIntentId  String?
  stripeCheckoutSessionId String?
  stripeEventId          String?
  notes                  String?
  recordedAt             DateTime
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  business               Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice                Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId, invoiceId, recordedAt])
  @@unique([stripePaymentIntentId])
  @@unique([stripeCheckoutSessionId])
  @@unique([stripeEventId])
}

model ActivityLog {
  id          String          @id @default(cuid())
  businessId  String
  actorUserId String?
  type        ActivityLogType
  title       String
  message     String
  metadata    Json?
  createdAt   DateTime        @default(now())
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, type, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
