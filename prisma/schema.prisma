generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  DISABLED
}

enum RoleKey {
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

model Business {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  status      BusinessStatus    @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  settings    BusinessSettings?
  roles       Role[]
  users       User[]            @relation("BusinessUsers")
  activeUsers User[]            @relation("UserActiveBusiness")
  clients     Client[]
  invoices    Invoice[]
}

model BusinessSettings {
  id           String   @id @default(cuid())
  businessId   String   @unique
  currencyCode String   @default("USD") @db.VarChar(3)
  timezone     String   @default("America/New_York")
  locale       String   @default("en-US")
  nextInvoiceNumber Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(cuid())
  businessId  String
  key         RoleKey
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([businessId, key])
  @@unique([businessId, id])
  @@index([businessId])
}

model User {
  id               String     @id @default(cuid())
  businessId       String
  activeBusinessId String?
  roleId           String
  status           UserStatus @default(ACTIVE)
  fullName         String
  email            String     @unique
  username         String     @unique
  phone            String?   @unique
  passwordHash     String
  image            String?
  emailVerified    DateTime?
  lastSignedInAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  business         Business   @relation("BusinessUsers", fields: [businessId], references: [id], onDelete: Cascade)
  activeBusiness   Business?  @relation("UserActiveBusiness", fields: [activeBusinessId], references: [id], onDelete: SetNull)
  role             Role       @relation(fields: [businessId, roleId], references: [businessId, id], onDelete: Restrict)
  accounts         Account[]
  sessions         Session[]
  clientProfile    Client?

  @@index([businessId])
  @@index([activeBusinessId])
  @@index([roleId])
  @@index([businessId, roleId])
  @@unique([businessId, id])
}

model Client {
  id          String       @id @default(cuid())
  businessId  String
  userId      String?
  status      ClientStatus @default(ACTIVE)
  fullName    String
  companyName String?
  email       String
  phone       String
  username    String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [businessId, userId], references: [businessId, id], onDelete: Restrict)
  invoices    Invoice[]

  @@index([businessId])
  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@unique([businessId, username])
  @@unique([businessId, userId])
  @@unique([businessId, id])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  clientId      String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime
  dueAt         DateTime
  subtotal      Int
  tax           Int           @default(0)
  total         Int
  paidAmount    Int           @default(0)
  taxRateBps    Int           @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lineItems     InvoiceLineItem[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, clientId])
  @@index([businessId, status, dueAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
